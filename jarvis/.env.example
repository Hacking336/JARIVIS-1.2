# JARVIS Environment Configuration
# Copy this file to .env and fill in your values

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
APP_HOST=127.0.0.0
APP_PORT=8080
APP_DEBUG=false
APP_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET

# ==============================================================================
# AI PROVIDER SETTINGS
# ==============================================================================
# Provider: 'local', 'cloud', 'llamacpp'
AI_PROVIDER=local

# Local AI (Ollama or compatible OpenAI API)
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=llama3.2:3b
LOCAL_AI_API_KEY=YOUR_LOCAL_AI_API_KEY

# Cloud AI (optional)
CLOUD_AI_API_KEY=
CLOUD_AI_MODEL=gpt-4o-mini
CLOUD_AI_BASE_URL=

# llama.cpp Server (local inference without Ollama)
LLAMACPP_ENABLED=false
LLAMACPP_SERVER_PATH=llama-server.exe
LLAMACPP_MODEL_PATH=C:\\JARVIS 1.2\\Qwen3-1.7B-Q4_K_M.gguf
LLAMACPP_HOST=127.0.0.1
LLAMACPP_PORT=8081
LLAMACPP_CTX_SIZE=4096
LLAMACPP_N_GPU_LAYERS=-1
LLAMACPP_THREADS=0
LLAMACPP_STARTUP_TIMEOUT=60
LLAMACPP_HEALTH_CHECK_TIMEOUT=5

# Fish Audio TTS
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_MODEL_ID=14129c3e320149449d6bada6862f7338
FISH_AUDIO_BASE_URL=https://api.fish.audio
FISH_AUDIO_SPEED=1.0
FISH_AUDIO_SAMPLE_RATE=44100

# Email - Gmail
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8080/auth/gmail/callback

# Email - Outlook
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:8080/auth/outlook/callback
OUTLOOK_TENANT_ID=common

# Speech Recognition
SPEECH_PROVIDER=local
SPEECH_LANGUAGE=en-US
SPEECH_TIMEOUT=5
SPEECH_PHRASE_TIMEOUT=3
VOSK_MODEL_PATH=

# System Monitoring
MONITOR_REFRESH_INTERVAL=2
PROCESS_REFRESH_INTERVAL=5
NETWORK_REFRESH_INTERVAL=3
ENABLE_GPU_MONITORING=false

# Database
DATABASE_URL=sqlite:///./data/jarvis.db

# Security
CREDENTIALS_ENCRYPTION_KEY=
SESSION_TIMEOUT=3600
MAX_FAILED_ATTEMPTS=5

# Notifications
ENABLE_DESKTOP_NOTIFICATIONS=true
NOTIFICATION_SOUND=true

# File Search
SEARCH_DIRECTORIES=C:\\Users\\,C:\\Projects\\
EXCLUDE_DIRECTORIES=C:\\Windows\\,C:\\Program Files\\,C:\\Program Files (x86)\\,C:\\.Bin\\,C:\\System Volume Information\\

# Approved Applications
APPROVED_APPLICATIONS=notepad.exe,calc.exe,code.exe,chrome.exe,firefox.exe,explorer.exe